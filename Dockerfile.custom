# Build web console
FROM --platform=linux/amd64 ubuntu:22.04 AS webconsole-build-stage
WORKDIR /webconsole
COPY ./server/webconsole/dist ./dist

# Build server from source - using latest Go for 1.24 compatibility
FROM --platform=linux/amd64 golang:1.24.3-bookworm AS server-build-stage
ENV BUILD_OS=linux
ENV BUILD_ARCH=amd64
ENV BUILD_VERSION=custom
WORKDIR /corteza
COPY ./server ./
COPY --from=webconsole-build-stage /webconsole/dist ./webconsole/dist
# Copy locale files to the expected location (3 levels up from pkg/locale)
COPY ./locale /locale
# Build locale files first
RUN make -C pkg/locale
# Build the binary only (skip release packaging that needs extra files)
RUN make build
# Manually create the expected directory structure
RUN mkdir -p build/pkg/corteza-server/bin && \
    cp build/corteza-server-custom-linux-amd64 build/pkg/corteza-server/bin/corteza-server && \
    cp -r provision build/pkg/corteza-server/

# Download official webapp (unchanged)
FROM --platform=linux/amd64 alpine:3 AS webapp-stage
ARG WEBAPP_VERSION=2024.9.10
ARG CORTEZA_WEBAPP_PATH=https://releases.cortezaproject.org/files/corteza-webapp-${WEBAPP_VERSION}.tar.gz
RUN mkdir -p /webapp
ADD $CORTEZA_WEBAPP_PATH /tmp/
RUN tar zxvf /tmp/corteza-webapp-${WEBAPP_VERSION}.tar.gz -C /webapp

# Final image
FROM --platform=linux/amd64 ubuntu:22.04

RUN apt-get -y update \
 && apt-get -y install \
    ca-certificates \
    curl \
 && rm -rf /var/lib/apt/lists/*

ARG SASS_VERSION=1.69.5
ARG SASS_URL=https://github.com/sass/dart-sass/releases/download/${SASS_VERSION}/dart-sass-${SASS_VERSION}-linux-x64.tar.gz

WORKDIR /opt
RUN curl -sOL $SASS_URL && tar -xzf dart-sass-${SASS_VERSION}-linux-x64.tar.gz && rm dart-sass-${SASS_VERSION}-linux-x64.tar.gz

ENV STORAGE_PATH="/data"
ENV CORREDOR_ADDR="corredor:80"
ENV HTTP_ADDR="0.0.0.0:80"
ENV HTTP_WEBAPP_ENABLED="true"
ENV HTTP_WEBAPP_BASE_DIR="/corteza/webapp"
ENV PATH="/opt/dart-sass:/corteza/bin:${PATH}"

WORKDIR /corteza

VOLUME /data

# Copy built server
COPY --from=server-build-stage /corteza/build/pkg/corteza-server ./

# Copy webapp
COPY --from=webapp-stage /webapp ./webapp

HEALTHCHECK --interval=30s --start-period=1m --timeout=30s --retries=3 \
    CMD curl --silent --fail --fail-early http://127.0.0.1:80/healthcheck || exit 1

EXPOSE 80

ENTRYPOINT ["./bin/corteza-server"]
CMD ["serve-api"]
